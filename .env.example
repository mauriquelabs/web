# Server
PING_MESSAGE="ping pong"
PORT=5000

# Supabase — client (Vite exposes VITE_* to the browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Supabase — server (JWT verification for /api/auth/* and future CMS routes)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Admin access — comma-separated emails (server enforcement)
ADMIN_EMAILS=you@mauriquelabs.com
# Mirror for client route guard (same value as ADMIN_EMAILS)
VITE_ADMIN_EMAILS=you@mauriquelabs.com
